---
import { getPhotoBySrc } from '../config/verifiedMedia.js';

interface PhotoItem {
  src: string;
  alt: string;
  title: string;
  category?: string;
  desc?: string;
  span?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  photos: PhotoItem[];
  columns?: '2' | '3' | '4';
}

const {
  title = "Verified Electrical Installations & Field Work Across 757",
  subtitle = "Authentic jobsite photographs of 200A panel upgrades, commercial switchgear, outdoor disconnects, and fixture rigging across Hampton Roads.",
  badge = "100% Real Jobsite Photography",
  photos,
  columns = '3'
} = Astro.props;

const enrichedPhotos = photos.map((p) => {
  const verified = getPhotoBySrc(p.src);
  if (!verified) {
    return {
      src: p.src,
      alt: p.alt,
      title: p.title,
      spec: p.category || 'FIELD WORK',
      desc: p.desc || '',
      fx: 50,
      fy: 50,
      span: p.span || '',
    };
  }
  return {
    src: verified.src,
    alt: verified.seoAlt,
    title: verified.title,
    spec: verified.technicalSpec,
    desc: verified.caption,
    fx: verified.focalPoint?.x ?? 50,
    fy: verified.focalPoint?.y ?? 50,
    span: p.span || '',
  };
});

const gridColsClass = columns === '4'
  ? 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6'
  : columns === '2'
    ? 'grid grid-cols-1 md:grid-cols-2 gap-6'
    : 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6';
---

<section class="py-16 bg-brand-surface border-t border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-3xl">
        {badge && (
          <span class="font-mono text-[11px] font-bold text-amber-400 bg-amber-500/10 px-3 py-1.5 rounded-full border border-amber-500/25 uppercase tracking-widest inline-block">
            {badge}
          </span>
        )}
        <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-white mt-3 tracking-tight">
          {title}
        </h2>
        <p class="text-sm sm:text-base text-slate-300 mt-2.5 leading-relaxed">
          {subtitle}
        </p>
      </div>

      <a
        href="tel:7575360478"
        class="shrink-0 inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs px-5 py-3 rounded-xl shadow-gold-glow transition-colors"
      >
        <span>Call 24/7: (757) 536-0478</span>
      </a>
    </div>

    <div class={gridColsClass}>
      {enrichedPhotos.map((photo) => (
        <article class={`group bento-card rounded-3xl overflow-hidden flex flex-col justify-between ${photo.span}`}>
          <div>
            <div class="relative aspect-[4/3.6] overflow-hidden bg-slate-950">
              <img
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                style={`object-position: ${photo.fx}% ${photo.fy}%; transform-origin: ${photo.fx}% ${photo.fy}%;`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
            </div>
            <div class="p-5">
              <h3 class="font-heading text-lg font-bold text-white group-hover:text-amber-300 transition-colors leading-snug">
                {photo.title}
              </h3>
              {photo.desc && (
                <p class="text-xs text-slate-300 mt-2 leading-relaxed">
                  {photo.desc}
                </p>
              )}
            </div>
          </div>
          <div class="px-5 pb-5 pt-0">
            <a
              href="tel:7575360478"
              class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-bold text-amber-400 hover:text-amber-300"
            >
              <span>Book Similar Work</span>
              <span class="font-mono">(757) 536-0478 →</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
