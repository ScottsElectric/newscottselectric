---
import Layout from '../layouts/Layout.astro';
import InteractiveQuoteCalculator from './InteractiveQuoteCalculator.jsx';
import AEOFAQ from './AEOFAQ.astro';
import JobsiteGallery from './JobsiteGallery.astro';
import AEODirectAnswer from './AEODirectAnswer.astro';
import { siteConfig } from '../config/site.js';
import { getPhotoBySrc } from '../config/verifiedMedia.js';

interface Props {
  slug: string;
  serviceName: string;
  pageTitle: string;
  metaDescription: string;
  keywords: string;
  priceRange: string;
  eyebrow: string;
  h1Plain: string;
  h1Italic: string;
  heroIntro: string;
  heroPhotoSrc: string;
  aeoQuestion: string;
  aeoSummary: string;
  aeoFacts: Array<{ label: string; value: string; highlight?: boolean }>;
  necSpecs: Array<{ code: string; title: string; detail: string }>;
  processSteps: Array<{ name: string; text: string }>;
  galleryPhotos: Array<{ src: string; alt: string; title: string }>;
  faqs: Array<{ question: string; answer: string }>;
}

const {
  slug,
  serviceName,
  pageTitle,
  metaDescription,
  keywords,
  priceRange,
  eyebrow,
  h1Plain,
  h1Italic,
  heroIntro,
  heroPhotoSrc,
  aeoQuestion,
  aeoSummary,
  aeoFacts,
  necSpecs,
  processSteps,
  galleryPhotos,
  faqs,
} = Astro.props;

const fullUrl = `${siteConfig.url}${slug.endsWith('/') ? slug : `${slug}/`}`;

const breadcrumbs = [
  { name: 'Home', url: `${siteConfig.url}/` },
  { name: 'Electrical Services', url: `${siteConfig.url}/services/` },
  { name: serviceName, url: fullUrl },
];

const serviceData = {
  name: serviceName,
  description: metaDescription,
  url: fullUrl,
  priceRange,
};

const verifiedHero = getPhotoBySrc(heroPhotoSrc);
const heroAlt = verifiedHero ? verifiedHero.seoAlt : `${serviceName} in Hampton Roads 757`;
const heroSpec = verifiedHero ? verifiedHero.technicalSpec : 'VERIFIED 757 FIELD WORK';
const heroFx = verifiedHero?.focalPoint?.x ?? 50;
const heroFy = verifiedHero?.focalPoint?.y ?? 50;
const ogImg = `${siteConfig.url}${heroPhotoSrc}`;

const howToSchema = {
  '@type': 'HowTo',
  '@id': `${fullUrl}#howto`,
  name: `How ${serviceName} Works in Hampton Roads (757)`,
  description: aeoSummary,
  step: processSteps.map((s, idx) => ({
    '@type': 'HowToStep',
    position: idx + 1,
    name: s.name,
    text: s.text,
  })),
};
---

<Layout
  title={pageTitle}
  description={metaDescription}
  keywords={keywords}
  ogImage={ogImg}
  serviceName={serviceName}
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
  customSchema={[howToSchema]}
>
  <!-- Sunlit Coastal Hero -->
  <section class="coastal-sand-surface py-14 lg:py-20 border-b border-coastal-navy/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-teal-700 inline-block">
            {eyebrow}
          </span>
          <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-coastal-navy leading-[1.06] tracking-tight">
            {h1Plain}{' '}
            <span class="relative inline-block">
              <span class="kinetic-stroke-teal kinetic-stroke-hero text-[1.13em]">
                {h1Italic}
              </span>
              <svg
                aria-hidden="true"
                viewBox="0 0 280 14"
                fill="none"
                preserveAspectRatio="none"
                class="pointer-events-none absolute -bottom-1 left-0 w-full h-3 overflow-visible"
              >
                <path
                  d="M4 10.5C82 3.5 190 3 276 9.5"
                  stroke="#D97706"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  pathLength="1"
                  class="pen-underline-hero"
                />
              </svg>
            </span>
          </h1>
          <p class="text-sm sm:text-lg text-coastal-slate leading-relaxed speakable">
            {heroIntro}
          </p>

          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
            <a
              href="tel:7575360478"
              class="cta-phone-beam inline-flex items-center justify-center gap-2.5 bg-coastal-navy hover:bg-slate-800 text-white font-extrabold px-7 py-4 rounded-2xl text-sm sm:text-base shadow-coastal-elevated whitespace-nowrap"
            >
              <span class="text-amber-400">●</span>
              <span>Call 24/7: (757) 536-0478</span>
            </a>
            <a
              href="#quote"
              class="inline-flex items-center justify-center border border-coastal-navy/20 hover:border-teal-700 bg-white text-coastal-navy font-bold px-6 py-4 rounded-2xl text-sm whitespace-nowrap"
            >
              <span>Calculate Project Cost&nbsp;↓</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="hero-bezel-shell rounded-[2rem] p-2.5 overflow-hidden relative">
            <div class="aspect-[4/4.2] rounded-[1.5rem] overflow-hidden bg-coastal-navy">
              <img
                src={heroPhotoSrc}
                alt={heroAlt}
                style={`object-position: ${heroFx}% ${heroFy}%;`}
                class="w-full h-full object-cover hf-cam-push-in"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Deep Chesapeake Navy AEO Direct Answer -->
  <section class="py-8 coastal-ocean-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AEODirectAnswer
        question={aeoQuestion}
        summary={aeoSummary}
        facts={aeoFacts}
        cityName="Hampton Roads (757)"
      />
    </div>
  </section>

  <!-- NEC Code & Technical Specifications + Step-by-Step Workflow -->
  <section class="py-20 coastal-dune-surface border-t border-coastal-navy/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <div>
        <div data-reveal-block class="max-w-3xl mb-10">
          <span class="font-mono text-[11px] font-bold uppercase tracking-widest text-teal-700">
            NEC &amp; VIRGINIA USBC ENGINEERING STANDARDS
          </span>
          <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-coastal-navy mt-2">
            Code-Compliant Materials &amp;{' '}
            <span class="font-editorial text-[1.12em] font-normal text-amber-600">
              Technical Execution
            </span>
          </h2>
        </div>

        <div data-deal-grid class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {necSpecs.map((spec) => (
            <div data-deal-item class="sand-card p-6 sm:p-7 rounded-3xl space-y-3">
              <span class="text-xs font-bold text-teal-700 bg-teal-600/10 px-2.5 py-1 rounded-md inline-block">
                {spec.code.split('//')[0].trim()}
              </span>
              <h3 class="font-heading text-xl font-extrabold text-coastal-navy">
                {spec.title}
              </h3>
              <p class="text-xs sm:text-sm text-coastal-slate leading-relaxed">
                {spec.detail}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Turnkey 4-Step Execution Timeline -->
      <div class="sand-card rounded-3xl p-6 sm:p-10">
        <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-coastal-navy mb-8">
          Step-by-Step {serviceName} Process in 757
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {processSteps.map((step, i) => (
            <div class="space-y-2 border-l-2 border-teal-600 pl-4">
              <span class="font-mono text-xs font-extrabold text-amber-600">
                STEP 0{i + 1}
              </span>
              <h3 class="font-heading text-base font-bold text-coastal-navy">
                {step.name}
              </h3>
              <p class="text-xs text-coastal-slate leading-relaxed">
                {step.text}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Field Gallery -->
  <JobsiteGallery
    title={`Verified ${serviceName} Field Work`}
    subtitle="Unretouched Hampton Roads jobsite photography documented by our licensed Virginia Master Electricians."
    badge="100% Real Jobsite Proof"
    photos={galleryPhotos}
    columns="3"
  />

  <!-- Interactive NEC Load & Quote Workbench -->
  <section id="quote" class="py-16 coastal-ocean-surface border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <!-- Service-Specific AEO FAQs -->
  <AEOFAQ faqs={faqs} title={`${serviceName} Cost, Code & Permit FAQs`} />

  <!-- Internal Topical Silo Cross-Links (All 7 Cities + Guides) -->
  <section class="py-12 coastal-dune-surface border-t border-coastal-navy/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h2 class="font-heading text-lg font-extrabold text-coastal-navy">
          Available 24/7 Across All 7 Hampton Roads Municipalities:
        </h2>
        <div class="flex flex-wrap gap-3 text-xs font-bold text-teal-700">
          <a href="/guides/757-electrical-cost-guide/" class="underline hover:text-coastal-navy">757 Cost Guide</a>
          <span>•</span>
          <a href="/guides/757-electrical-permits-dominion-energy/" class="underline hover:text-coastal-navy">757 Permits &amp; Dominion Guide</a>
          <span>•</span>
          <a href="/services/" class="underline hover:text-coastal-navy">All 14 Electrical Scopes</a>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        {siteConfig.serviceAreas.map((area) => (
          <a
            href={area.slug}
            class="px-3.5 py-2 rounded-full bg-white border border-coastal-navy/15 hover:border-teal-600 text-xs font-bold text-coastal-navy transition-colors"
          >
            {serviceName} in {area.name}, VA →
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
