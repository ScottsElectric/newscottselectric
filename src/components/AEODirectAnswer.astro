---
interface Fact {
  label: string;
  value: string;
  highlight?: boolean;
}

interface Props {
  question?: string;
  summary: string;
  facts?: Fact[];
  cityName?: string;
  serviceName?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  question,
  summary,
  facts = [],
  cityName = "Hampton Roads",
  ctaText = "Call 24/7 Dispatch: (757) 536-0478",
  ctaLink = "tel:7575360478"
} = Astro.props;
---

<div class="my-10 aeo-direct-answer bento-card rounded-3xl p-6 md:p-8 relative overflow-hidden">
  <div class="absolute -top-12 -right-12 w-40 h-40 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

  <div class="relative z-10">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
      <span class="text-xs font-bold uppercase tracking-[0.15em] text-amber-400">
        Pricing &amp; Service Overview • {cityName}
      </span>
    </div>

    {question && (
      <h2 class="font-heading text-lg md:text-2xl font-extrabold text-white mb-3 speakable">
        {question}
      </h2>
    )}

    <p class="text-sm md:text-base text-slate-200 leading-relaxed speakable">
      {summary}
    </p>

    {facts.length > 0 && (
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pt-6 border-t border-slate-800/90">
        {facts.map(fact => (
          <div class={`p-3.5 rounded-xl border ${fact.highlight ? 'bg-amber-500/10 border-amber-500/30 text-white' : 'bg-slate-950/70 border-slate-800 text-slate-300'}`}>
            <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-400">
              {fact.label}
            </div>
            <div class={`text-sm font-extrabold mt-0.5 ${fact.highlight ? 'text-amber-300' : 'text-white'}`}>
              {fact.value}
            </div>
          </div>
        ))}
      </div>
    )}

    <div class="mt-6 pt-4 border-t border-slate-800/60 flex flex-wrap items-center justify-between gap-4">
      <div class="text-xs text-slate-300">
        <strong class="text-white">Credentials:</strong> Virginia Master Electrician — Licensed &amp; Insured VA Class A Contractor
      </div>
      <a
        href={ctaLink}
        class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold px-5 py-2.5 rounded-xl text-xs shadow-gold-glow transition-colors"
      >
        <span>{ctaText}</span>
        <span>→</span>
      </a>
    </div>
  </div>
</div>
