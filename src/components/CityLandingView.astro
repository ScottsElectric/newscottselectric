---
import Layout from '../layouts/Layout.astro';
import AEOFAQ from './AEOFAQ.astro';
import InteractiveQuoteCalculator from './InteractiveQuoteCalculator.jsx';
import JobsiteGallery from './JobsiteGallery.astro';
import AEODirectAnswer from './AEODirectAnswer.astro';
import { siteConfig } from '../config/site.js';
import { getPhotoBySrc } from '../config/verifiedMedia.js';

interface Props {
  cityName: string;
  slug: string;
  pageTitle: string;
  metaDescription: string;
  eyebrow: string;
  h1Lead: string;
  heroIntro: string;
  heroPhotoSrc: string;
  aeoQuestion: string;
  aeoSummary: string;
  aeoFacts: Array<{ label: string; value: string; highlight?: boolean }>;
  localScopes: Array<{ code: string; title: string; desc: string; href?: string }>;
  galleryPhotos: Array<{ src: string; alt: string; title: string }>;
  faqs: Array<{ question: string; answer: string }>;
}

const {
  cityName,
  slug,
  pageTitle,
  metaDescription,
  eyebrow,
  h1Lead,
  heroIntro,
  heroPhotoSrc,
  aeoQuestion,
  aeoSummary,
  aeoFacts,
  localScopes,
  galleryPhotos,
  faqs,
} = Astro.props;

const fullUrl = `${siteConfig.url}${slug.endsWith('/') ? slug : `${slug}/`}`;

const breadcrumbs = [
  { name: 'Home', url: `${siteConfig.url}/` },
  { name: `${cityName}, VA Electrician`, url: fullUrl },
];

const verifiedHero = getPhotoBySrc(heroPhotoSrc);
const heroAlt = verifiedHero ? verifiedHero.seoAlt : `Licensed Master Electrician in ${cityName}, VA`;
const heroSpec = verifiedHero ? verifiedHero.technicalSpec : `${cityName.toUpperCase()} FIELD WORK`;
const heroFx = verifiedHero?.focalPoint?.x ?? 50;
const heroFy = verifiedHero?.focalPoint?.y ?? 50;
const ogImg = `${siteConfig.url}${heroPhotoSrc}`;

const areaMeta = siteConfig.serviceAreas.find(
  (a) => a.name.toLowerCase() === cityName.toLowerCase()
);
---

<Layout
  title={pageTitle}
  description={metaDescription}
  ogImage={ogImg}
  cityName={cityName}
  serviceName={`24/7 Master Electrician in ${cityName}`}
  breadcrumbs={breadcrumbs}
>
  <!-- Sunlit Coastal City Hero -->
  <section class="coastal-sand-surface py-14 lg:py-20 border-b border-coastal-navy/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-teal-700 inline-block">
            {eyebrow}
          </span>
          <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-coastal-navy leading-[1.06] tracking-tight">
            {h1Lead}{' '}
            <span class="relative inline-block">
              <span class="kinetic-stroke-teal kinetic-stroke-hero text-[1.13em]">
                in {cityName}, VA
              </span>
              <svg
                aria-hidden="true"
                viewBox="0 0 260 14"
                fill="none"
                preserveAspectRatio="none"
                class="pointer-events-none absolute -bottom-1 left-0 w-full h-3 overflow-visible"
              >
                <path
                  d="M4 10.5C78 3.5 180 3 256 9.5"
                  stroke="#D97706"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  pathLength="1"
                  class="pen-underline-hero"
                />
              </svg>
            </span>
          </h1>
          <p class="text-sm sm:text-lg text-coastal-slate leading-relaxed speakable">
            {heroIntro}
          </p>

          <!-- Phone-First CTA Pair -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
            <a
              href="tel:7575360478"
              class="cta-phone-beam inline-flex items-center justify-center gap-2.5 bg-coastal-navy hover:bg-slate-800 text-white font-extrabold px-7 py-4 rounded-2xl text-sm sm:text-base shadow-coastal-elevated whitespace-nowrap"
            >
              <span class="text-amber-400">●</span>
              <span>Call 24/7: (757) 536-0478</span>
            </a>
            <a
              href="#quote"
              class="inline-flex items-center justify-center border border-coastal-navy/20 hover:border-teal-700 bg-white text-coastal-navy font-bold px-6 py-4 rounded-2xl text-sm whitespace-nowrap"
            >
              <span>NEC Load &amp; Price Estimator&nbsp;↓</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="hero-bezel-shell rounded-[2rem] p-2.5 overflow-hidden relative">
            <div class="aspect-[4/4.2] rounded-[1.5rem] overflow-hidden bg-coastal-navy">
              <img
                src={heroPhotoSrc}
                alt={heroAlt}
                style={`object-position: ${heroFx}% ${heroFy}%;`}
                class="w-full h-full object-cover hf-cam-push-in"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Deep Chesapeake Navy AEO Direct Answer -->
  <section class="py-8 coastal-ocean-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AEODirectAnswer
        question={aeoQuestion}
        summary={aeoSummary}
        facts={aeoFacts}
        cityName={cityName}
      />
    </div>
  </section>

  <!-- Local Technical Scopes + Neighborhood & Permit Coverage -->
  <section class="py-20 coastal-dune-surface border-t border-coastal-navy/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      <div>
        <div class="max-w-3xl mb-10">
          <span class="font-mono text-[11px] font-bold uppercase tracking-widest text-teal-700">
            LOCAL {cityName.toUpperCase()} ENGINEERING PRIORITIES
          </span>
          <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-coastal-navy mt-2">
            High-Demand Electrical Scopes in{' '}
            <span class="font-editorial text-[1.12em] font-normal text-amber-600">
              {cityName}, Virginia
            </span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {localScopes.map((scope) => (
            <div class="sand-card p-6 sm:p-7 rounded-3xl flex flex-col justify-between space-y-4">
              <div class="space-y-2.5">
                <h3 class="font-heading text-xl font-extrabold text-coastal-navy">
                  {scope.title}
                </h3>
                <p class="text-xs sm:text-sm text-coastal-slate leading-relaxed">
                  {scope.desc}
                </p>
              </div>
              <a
                href={scope.href || 'tel:7575360478'}
                class="pt-3 border-t border-coastal-navy/10 text-xs font-extrabold text-teal-700 hover:text-coastal-navy"
              >
                {scope.href ? `View ${scope.title} →` : `Call (757) 536-0478 →`}
              </a>
            </div>
          ))}
        </div>
      </div>

      {areaMeta && (
        <div class="sand-card p-6 sm:p-8 rounded-3xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-7 space-y-3">
            <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-teal-700">
              NEIGHBORHOODS &amp; POSTAL CORRIDORS SERVED 24/7
            </span>
            <h3 class="font-heading text-xl sm:text-2xl font-extrabold text-coastal-navy">
              {cityName} Communities &amp; ZIP Codes
            </h3>
            <p class="text-xs sm:text-sm text-coastal-slate leading-relaxed">
              <strong>Neighborhoods:</strong> {areaMeta.neighborhoods.join(' • ')}
            </p>
            <p class="font-mono text-xs text-coastal-navy font-semibold">
              Active {cityName} ZIP Codes: {areaMeta.zipCodes.join(', ')}
            </p>
          </div>
          <div class="lg:col-span-5 bg-coastal-sand/80 p-5 rounded-2xl border border-coastal-navy/10 space-y-2.5">
            <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-amber-700">
              MUNICIPAL PERMITTING AUTHORITY
            </span>
            <div class="font-heading text-sm font-extrabold text-coastal-navy">
              {areaMeta.permitOffice}
            </div>
            <p class="text-xs text-coastal-slate leading-relaxed">
              Scott's Electric LLC handles all {cityName} electrical permit filings, inspections, and Dominion Energy same-day reconnects.
            </p>
            <a
              href="/guides/757-electrical-permits-dominion-energy/"
              class="inline-block text-xs font-bold text-teal-700 hover:text-coastal-navy underline"
            >
              Read 757 Municipal Permit Guide →
            </a>
          </div>
        </div>
      )}

      <!-- Complete 14-Service Directory Cross-Links for Local City Crawlability -->
      <div class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="font-heading text-xl font-extrabold text-coastal-navy">
            All 14 Master Electrical Services Available in {cityName}, VA:
          </h2>
          <a href="/guides/757-electrical-cost-guide/" class="text-xs font-bold text-teal-700 underline hover:text-coastal-navy">
            View 2026–2027 {cityName} Cost Guide →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
          {siteConfig.services.map((svc) => {
            const path = new URL(svc.url).pathname;
            return (
              <a
                href={path}
                class="flex items-center justify-between px-4 py-3 rounded-2xl bg-white border border-coastal-navy/12 hover:border-teal-600 text-xs font-bold text-coastal-navy transition-colors"
              >
                <span class="truncate pr-2">{svc.name}</span>
                <span class="font-mono text-[10px] text-teal-700 shrink-0">{svc.priceRange}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <JobsiteGallery
    title={`Verified Jobsite Installations Serving ${cityName} & 757`}
    subtitle="Authentic field photographs of 200A panels, commercial switchgear, outdoor disconnects, and fixture mounts."
    badge="100% Real Field Photography"
    photos={galleryPhotos}
    columns="4"
  />

  <section id="quote" class="py-16 coastal-ocean-surface border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title={`${cityName}, VA Electrical Permit, Cost & Dispatch FAQs`} cityName={cityName} />
</Layout>
