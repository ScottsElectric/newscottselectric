---
const cities = [
  { name: 'Virginia Beach', slug: '/virginia-beach-electrician/' },
  { name: 'Norfolk', slug: '/norfolk-electrician/' },
  { name: 'Chesapeake', slug: '/chesapeake-electrician/' },
  { name: 'Newport News', slug: '/newport-news-electrician/' },
  { name: 'Hampton', slug: '/hampton-electrician/' },
  { name: 'Portsmouth', slug: '/portsmouth-electrician/' },
  { name: 'Suffolk', slug: '/suffolk-electrician/' }
];

const primaryServices = [
  { name: '24/7 Emergency Electrician', slug: '/services/emergency-electrician-757/' },
  { name: '200A & 400A Panel Upgrades', slug: '/services/electrical-panel-upgrades/' },
  { name: 'Level 2 EV Charger Circuits', slug: '/services/ev-charger-installation/' },
  { name: 'Whole-Home Standby Generators', slug: '/services/whole-home-generators/' },
  { name: 'NEC 680 Pool & Hot Tub Wiring', slug: '/services/pool-hot-tub-wiring/' },
  { name: 'Historic Rewiring & Aluminum', slug: '/services/historic-home-rewiring/' },
  { name: 'Meter Bases & Weatherheads', slug: '/services/meter-base-weatherhead-repair/' }
];

const specialtyServices = [
  { name: '2-Story Chandeliers & Fans', slug: '/services/ceiling-fan-chandelier-installation/' },
  { name: 'Detached Shop Subpanels', slug: '/services/subpanel-workshop-wiring/' },
  { name: 'Whole-Home Surge (NEC 230.67)', slug: '/services/whole-home-surge-protection/' },
  { name: 'Code & Home-Sale Inspections', slug: '/services/electrical-code-inspections/' },
  { name: 'Recessed LED & Landscape', slug: '/services/custom-lighting-installation/' },
  { name: 'Smart Switches & Energy Monitors', slug: '/services/smart-home-automation/' },
  { name: '3-Phase Commercial Electrical', slug: '/services/commercial-electrical/' }
];
---

<header class="fixed top-0 left-0 right-0 z-40 glass-nav">
  <!-- Subtle Top Coastal Horizon Hairline -->
  <div class="h-[2px] w-full bg-gradient-to-r from-transparent via-teal-400/50 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[78px] gap-3">
      <!-- Architectural Brand Lockup -->
      <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="757 Master Electrician — Scott's Electric Home">
        <div class="relative p-1 rounded-xl bg-white/[0.04] border border-white/10 group-hover:border-amber-400/40 transition-colors">
          <img
            src="/assets/images/scotts_electric_logo_transparent.png"
            alt="Licensed Master Electrician in Hampton Roads VA — Scott's Electric Emblem"
            width="60"
            height="60"
            class="h-11 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform duration-300"
          />
        </div>
        <div class="hidden sm:block leading-tight">
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span class="font-mono text-[9.5px] font-semibold uppercase tracking-[0.2em] text-amber-300">
              757 MASTER ELECTRICIAN
            </span>
          </div>
          <span class="block font-heading text-[15px] font-extrabold text-white tracking-tight mt-0.5">
            Scott&rsquo;s Electric <span class="text-slate-400 font-medium text-xs">LLC</span>
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1.5 xl:gap-2 text-xs xl:text-[13px] font-semibold text-slate-200" aria-label="Main Navigation">
        <!-- 14 Electrical Services Mega-Dropdown -->
        <div class="relative group py-3">
          <button type="button" class="flex items-center gap-1.5 px-3 py-2 rounded-full hover:bg-white/[0.06] hover:text-white transition-colors focus:outline-none" aria-expanded="false" aria-haspopup="true">
            <span>14 Services</span>
            <svg class="w-3.5 h-3.5 text-amber-400 group-hover:rotate-180 transition-transform duration-200" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute top-full -left-4 w-[540px] glass-panel rounded-2xl p-4 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 shadow-2xl border border-white/12">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <div class="px-2.5 pb-1.5 font-mono text-[10px] font-bold uppercase tracking-widest text-amber-300">
                  Core Residential &amp; 24/7
                </div>
                {primaryServices.map(service => (
                  <a href={service.slug} class="block px-2.5 py-2 rounded-lg text-xs text-slate-200 hover:bg-white/[0.07] hover:text-amber-300 transition-colors">
                    {service.name}
                  </a>
                ))}
              </div>
              <div>
                <div class="px-2.5 pb-1.5 font-mono text-[10px] font-bold uppercase tracking-widest text-teal-300">
                  Specialty &amp; Commercial
                </div>
                {specialtyServices.map(service => (
                  <a href={service.slug} class="block px-2.5 py-2 rounded-lg text-xs text-slate-200 hover:bg-white/[0.07] hover:text-teal-300 transition-colors">
                    {service.name}
                  </a>
                ))}
              </div>
            </div>
            <div class="border-t border-white/10 mt-3 pt-2.5 flex items-center justify-between px-2.5">
              <a href="/services/" class="text-xs font-bold text-teal-300 hover:text-white transition-colors">
                Browse All 14 Electrical Scopes →
              </a>
              <a href="/guides/757-electrical-cost-guide/" class="text-xs font-bold text-amber-300 hover:text-white transition-colors">
                2026–2027 Cost Guide →
              </a>
            </div>
          </div>
        </div>

        <!-- 7 Cities Dropdown -->
        <div class="relative group py-3">
          <button type="button" class="flex items-center gap-1.5 px-3 py-2 rounded-full hover:bg-white/[0.06] hover:text-white transition-colors focus:outline-none" aria-expanded="false" aria-haspopup="true">
            <span class="text-amber-300">757 Cities</span>
            <svg class="w-3.5 h-3.5 text-amber-400 group-hover:rotate-180 transition-transform duration-200" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute top-full left-0 w-56 glass-panel rounded-2xl py-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 shadow-2xl border border-white/12">
            {cities.map(city => (
              <a href={city.slug} class="block px-4 py-2 text-xs text-slate-200 hover:bg-white/[0.07] hover:text-amber-300 transition-colors">
                {city.name}, VA Electrician
              </a>
            ))}
          </div>
        </div>

        <!-- Cost & Permit Guides Dropdown -->
        <div class="relative group py-3">
          <button type="button" class="flex items-center gap-1.5 px-3 py-2 rounded-full hover:bg-white/[0.06] hover:text-white transition-colors focus:outline-none" aria-expanded="false" aria-haspopup="true">
            <span>Pricing &amp; Guides</span>
            <svg class="w-3.5 h-3.5 text-amber-400 group-hover:rotate-180 transition-transform duration-200" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute top-full left-0 w-72 glass-panel rounded-2xl py-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 shadow-2xl border border-white/12">
            <a href="/guides/757-electrical-cost-guide/" class="block px-4 py-2.5 text-xs text-slate-200 hover:bg-white/[0.07] hover:text-amber-300 transition-colors">
              2026–2027 757 Cost &amp; Pricing Guide
            </a>
            <a href="/guides/757-electrical-permits-dominion-energy/" class="block px-4 py-2.5 text-xs text-slate-200 hover:bg-white/[0.07] hover:text-amber-300 transition-colors">
              757 Permits &amp; Dominion Energy Guide
            </a>
            <a href="/faqs/" class="block px-4 py-2.5 text-xs text-slate-200 hover:bg-white/[0.07] hover:text-amber-300 transition-colors">
              50 Master Electrician FAQs
            </a>
          </div>
        </div>

        <a href="/faqs/" class="px-3 py-2 rounded-full hover:bg-white/[0.06] hover:text-amber-300 transition-colors">50 FAQs</a>
        <a href="/contact/" class="px-3 py-2 rounded-full hover:bg-white/[0.06] hover:text-amber-300 transition-colors">Quote Form</a>
      </nav>

      <!-- Tactile Sunlit Amber Dispatch Pill + Mobile Menu Toggle -->
      <div class="flex items-center gap-2.5">
        <a
          href="tel:7575360478"
          class="inline-flex items-center gap-2.5 bg-gradient-to-b from-amber-300 via-amber-400 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-slate-950 px-3.5 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all shadow-[inset_0_1px_0_rgba(255,255,255,0.8),0_8px_22px_-6px_rgba(245,158,11,0.55)] hover:scale-[1.015] min-h-[44px]"
        >
          <span class="relative flex h-2 w-2 shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-700 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-800"></span>
          </span>
          <svg class="w-3.5 h-3.5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span class="font-mono tracking-tight font-extrabold">(757) 536-0478</span>
        </a>

        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden p-2.5 rounded-xl bg-slate-900/90 border border-white/12 text-slate-200 hover:text-amber-300 focus:outline-none min-h-[44px] min-w-[44px] flex items-center justify-center"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-slate-950/98 border-b border-slate-800 px-4 pt-3 pb-6 space-y-4 max-h-[82vh] overflow-y-auto">
    <div class="grid grid-cols-2 gap-2">
      <a href="/services/" class="px-3 py-2.5 rounded-xl bg-slate-900 text-xs font-bold text-slate-200">All 14 Services</a>
      <a href="/guides/757-electrical-cost-guide/" class="px-3 py-2.5 rounded-xl bg-slate-900 text-xs font-bold text-amber-400">2026 Cost Guide</a>
      <a href="/faqs/" class="px-3 py-2.5 rounded-xl bg-slate-900 text-xs font-bold text-slate-200">50 NEC FAQs</a>
      <a href="/contact/" class="px-3 py-2.5 rounded-xl bg-slate-900 text-xs font-bold text-cyan-400">Quote Form</a>
    </div>

    <div>
      <div class="px-1 pb-1.5 font-mono text-[10px] font-bold uppercase tracking-widest text-amber-400">757 Service Cities</div>
      <div class="grid grid-cols-2 gap-1.5">
        {cities.map(city => (
          <a href={city.slug} class="text-xs text-slate-300 hover:text-amber-400 py-2 px-2.5 rounded-lg bg-slate-900/60">
            {city.name}, VA
          </a>
        ))}
      </div>
    </div>

    <div>
      <div class="px-1 pb-1.5 font-mono text-[10px] font-bold uppercase tracking-widest text-cyan-400">Electrical Services</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-1">
        {primaryServices.concat(specialtyServices).map(service => (
          <a href={service.slug} class="block text-xs text-slate-300 hover:text-amber-400 py-2 px-2 rounded-lg hover:bg-slate-900">
            {service.name}
          </a>
        ))}
      </div>
    </div>

    <div class="pt-2 border-t border-slate-800">
      <a href="tel:7575360478" class="block text-center bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 font-extrabold py-3.5 rounded-xl text-sm">
        Call 24/7 Dispatch: (757) 536-0478
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.classList.add('hidden'));
    });
  }
</script>
