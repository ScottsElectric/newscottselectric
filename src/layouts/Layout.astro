---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import LeadPopup from '../components/LeadPopup.jsx';
import CoastalIntroDirector from '../components/CoastalIntroDirector.jsx';
import CoastalScrollEngine from '../components/CoastalScrollEngine.jsx';
import { siteConfig } from '../config/site.js';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  cityName?: string;
  serviceName?: string;
  canonicalUrl?: string;
  ogImage?: string;
  keywords?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  customSchema?: any[];
  isServicePage?: boolean;
  noindex?: boolean;
  serviceData?: {
    name: string;
    description: string;
    url: string;
    priceRange?: string;
  };
}

const rawPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const normalizedCanonical = `${siteConfig.url}${rawPath === '//' ? '/' : rawPath}`;

const {
  title = "24/7 Emergency Electrician, 200A Panel Upgrades & EV Chargers in Virginia Beach, Norfolk & 757 | Scott's Electric",
  description = "Licensed Virginia Master Electrician serving all 7 cities of Hampton Roads (757). 24/7 Emergency Electrical Repair, 200A/400A Panel Upgrades, Level 2 EV Chargers, 3-Phase Commercial & Standby Generators. Call (757) 536-0478.",
  cityName = "Hampton Roads",
  serviceName = "24/7 Master Electrician Services",
  canonicalUrl = normalizedCanonical,
  ogImage = siteConfig.heroImage,
  keywords = `24/7 emergency electrician ${cityName}, 200 amp panel upgrade ${cityName}, licensed master electrician 757, EV charger installation ${cityName}, standby generator installation Virginia Beach, commercial 3-phase electrician Norfolk, pool wiring Chesapeake, Scott's Electric`,
  breadcrumbs,
  customSchema,
  isServicePage = false,
  noindex = false,
  serviceData
} = Astro.props;

const currentArea = siteConfig.serviceAreas.find(a => a.name.toLowerCase() === cityName.toLowerCase());
const geoLatitude = currentArea ? currentArea.geo.latitude : siteConfig.hqGeo.latitude;
const geoLongitude = currentArea ? currentArea.geo.longitude : siteConfig.hqGeo.longitude;
const geoRegion = "US-VA";
const geoPlacename = cityName === "Hampton Roads" ? "Virginia Beach" : cityName;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Scott's Electric LLC" />

  <!-- Preconnect Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Canonical & Search/AI Bot Directives -->
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
  <meta name="googlebot" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
  <meta name="bingbot" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
  <meta name="theme-color" content="#0A1929" />
  <link rel="manifest" href="/manifest.json" />

  <!-- Geographic Meta Tags for Local & Maps Search (AEO / Local SEO) -->
  <meta name="geo.region" content={geoRegion} />
  <meta name="geo.placename" content={`${geoPlacename}, Virginia`} />
  <meta name="geo.position" content={`${geoLatitude};${geoLongitude}`} />
  <meta name="ICBM" content={`${geoLatitude}, ${geoLongitude}`} />

  <!-- OpenGraph / Social Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:image:width" content="1440" />
  <meta property="og:image:height" content="1920" />
  <meta property="og:site_name" content="24/7 Electrician 757 — Scott's Electric" />
  <meta property="og:locale" content="en_US" />
  <meta property="business:contact_data:phone_number" content={siteConfig.phoneE164} />
  <meta property="business:contact_data:locality" content={geoPlacename} />
  <meta property="business:contact_data:region" content="VA" />
  <meta property="business:contact_data:country_name" content="USA" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />

  <meta name="format-detection" content="telephone=yes" />

  <!-- AI Discovery & Sitemap Endpoints -->
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Agent Summary" />
  <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Exhaustive LLM Knowledge Graph" />
  <link rel="alternate" type="text/html" href="/ax/" title="Agent Experience (AX) Entity Cockpit" />

  <!-- Favicons & Apple Touch Icon -->
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" href="/logo192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Schema.org Microdata & JSON-LD Knowledge Graph -->
  <SchemaMarkup
    cityName={cityName}
    serviceName={serviceName}
    pageTitle={title}
    pageDescription={description}
    canonicalUrl={canonicalUrl}
    ogImage={ogImage}
    breadcrumbs={breadcrumbs}
    customSchema={customSchema}
    isServicePage={isServicePage}
    serviceData={serviceData}
  />
  <!-- Zero-Flash Pre-Paint Curtain for First-Visit Desktop Homepage Intro -->
  <script is:inline>
    (function () {
      try {
        var p = new URLSearchParams(window.location.search);
        var force = p.get('intro') === '1';
        var skip = p.get('intro') === '0';
        var isHome = window.location.pathname === '/' || window.location.pathname === '';
        var isDesktop = window.innerWidth >= 1024;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = sessionStorage.getItem('scotts_coastal_intro_v1') === '1';
        if (force || (!skip && isHome && isDesktop && !reduced && !navigator.webdriver && !seen)) {
          document.documentElement.setAttribute('data-intro-curtain', '1');
          setTimeout(function () {
            document.documentElement.removeAttribute('data-intro-curtain');
          }, 3200);
        }
      } catch (e) {}
    })();
  </script>
  <style is:inline>
    #intro-prepaint-curtain { display: none; }
    html[data-intro-curtain="1"] #intro-prepaint-curtain {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 69;
      background: #06101C;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>
<body class="bg-brand-dark text-brand-text min-h-screen flex flex-col antialiased selection:bg-amber-400 selection:text-slate-950 relative">
  <!-- Netlify Form Discovery Declaration -->
  <form name="quote-request" data-netlify="true" data-netlify-honeypot="bot-field" hidden aria-hidden="true">
    <input type="text" name="name" />
    <input type="tel" name="phone" />
    <input type="email" name="email" />
    <input type="text" name="city" />
    <input type="text" name="urgency" />
    <input type="text" name="services" />
    <input type="text" name="estimatedBudget" />
  </form>

  <form name="popup" data-netlify="true" data-netlify-honeypot="bot-field" hidden aria-hidden="true">
    <input type="text" name="name" />
    <input type="tel" name="phone" />
    <input type="email" name="email" />
    <input type="text" name="city" />
    <input type="text" name="service" />
  </form>

  <!-- Instant Pre-Paint Curtain (Seamless 0ms Handoff Into CoastalIntroDirector) -->
  <div id="intro-prepaint-curtain" aria-hidden="true">
    <div style="width:24%;height:2px;background:linear-gradient(90deg,transparent,#fbbf24,transparent);opacity:0.85;"></div>
  </div>

  <!-- Desktop Motion-Edit Intro Sequence + Aperture Seam Handoff -->
  <CoastalIntroDirector client:load />

  <!-- Global GSAP + ScrollTrigger + Lenis Continuous Scroll Engine -->
  <CoastalScrollEngine client:load />

  <!-- Immediate Residential-to-Upgrade Dispatch Funnel Modal -->
  <LeadPopup client:load />

  <!-- Accessibility Skip Link -->
  <a href="#main-content" class="skip-to-content">
    Skip to main content
  </a>

  <!-- Header Navigation -->
  <Header />

  <!-- Main Content Body -->
  <main id="main-content" class="flex-grow pt-20">
    <slot />
  </main>

  <!-- Sticky Phone-First 24/7 Emergency Dispatch Dock (Reveals Smoothly On Scroll Past Hero) -->
  <div
    id="floating-dispatch-dock"
    class="fixed bottom-4 right-4 left-4 sm:left-auto z-40 flex items-center justify-end gap-2 pointer-events-none opacity-0 translate-y-4 transition-all duration-300"
  >
    <button
      type="button"
      id="sticky-callback-btn"
      aria-label="Request a phone callback"
      class="pointer-events-auto hidden sm:inline-flex items-center gap-2 bg-slate-950/95 hover:bg-slate-900 border border-slate-700 hover:border-amber-400/60 text-slate-200 font-bold text-xs px-4 py-3.5 rounded-full shadow-card backdrop-blur-md transition-colors"
    >
      <span>Request Callback</span>
    </button>

    <a
      href="tel:7575360478"
      aria-label="Call 24/7 Emergency Electrician at (757) 536-0478"
      class="pointer-events-auto cta-phone-beam w-full sm:w-auto flex items-center justify-center gap-3 bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-500 hover:from-amber-400 hover:to-yellow-300 text-slate-950 font-extrabold px-5 py-3.5 rounded-full shadow-gold-intense transition-transform hover:scale-[1.02]"
    >
      <span class="relative flex h-2.5 w-2.5 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-600 opacity-80"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-700"></span>
      </span>
      <svg class="w-4 h-4 text-slate-950 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
      </svg>
      <span class="tracking-tight text-sm sm:text-base whitespace-nowrap">24/7 Dispatch: (757) 536-0478</span>
    </a>
  </div>

  <!-- Footer -->
  <Footer />

  <script>
    const cbBtn = document.getElementById('sticky-callback-btn');
    const dock = document.getElementById('floating-dispatch-dock');
    if (cbBtn) {
      cbBtn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-callback-modal'));
      });
    }
    if (dock) {
      const syncDock = () => {
        if (window.scrollY > 300) {
          dock.classList.remove('opacity-0', 'translate-y-4');
          dock.classList.add('opacity-100', 'translate-y-0');
        } else {
          dock.classList.add('opacity-0', 'translate-y-4');
          dock.classList.remove('opacity-100', 'translate-y-0');
        }
      };
      syncDock();
      window.addEventListener('scroll', syncDock, { passive: true });
    }
  </script>
</body>
</html>
